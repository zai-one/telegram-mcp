# Set process environment explicitly. Do not store real credentials in this file.
TELEGRAM_SECRET_FILE=/run/secrets/telegram.env
TELEGRAM_BINDINGS_FILE=/run/secrets/telegram-bindings.json
TELEGRAM_STATE_PATH=/var/lib/telegram-mcp/state.sqlite
TELEGRAM_ACCOUNT_ID=default
TELEGRAM_LOCAL_PRINCIPAL=local-operator
TELEGRAM_LOCAL_SCOPES=telegram:read
TELEGRAM_ENABLED=true
TELEGRAM_WRITE_ENABLED=false
TELEGRAM_RATE_LIMIT=30
TELEGRAM_WRITE_RATE_LIMIT=20
TELEGRAM_HIGH_RISK_RATE_LIMIT=3
TELEGRAM_MAX_CONCURRENCY=2
# HTTP only: public key, not a private signing key.
TELEGRAM_MCP_PUBLIC_KEY_FILE=/etc/telegram-mcp/operator-public.pem
TELEGRAM_MCP_ISSUER=telegram-operator
TELEGRAM_MCP_AUDIENCE=telegram-mcp
