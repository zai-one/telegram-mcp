# Set process environment explicitly. Do not store real credentials in this file.
TELEGRAM_SECRET_FILE=/run/secrets/telegram.env
TELEGRAM_BINDINGS_FILE=/run/secrets/telegram-bindings.json
TELEGRAM_STATE_PATH=/var/lib/telegram-mcp/state.sqlite
TELEGRAM_ACCOUNT_ID=default
TELEGRAM_LOCAL_PRINCIPAL=local-operator
TELEGRAM_LOCAL_SCOPES=telegram:read
TELEGRAM_ENABLED=true
TELEGRAM_WRITE_ENABLED=false
TELEGRAM_RATE_LIMIT=30
TELEGRAM_WRITE_RATE_LIMIT=20
TELEGRAM_HIGH_RISK_RATE_LIMIT=3
TELEGRAM_MAX_CONCURRENCY=2
# Optional operator-only media policy; file operations stay disabled without it.
# TELEGRAM_MEDIA_POLICY_FILE=/etc/telegram-mcp/media.json
# HTTP only: public key, not a private signing key.
TELEGRAM_MCP_PUBLIC_KEY_FILE=/etc/telegram-mcp/operator-public.pem
TELEGRAM_MCP_ISSUER=telegram-operator
TELEGRAM_MCP_AUDIENCE=telegram-mcp
# Optional: disable the suggest-only GitHub release check (telegram_check_update).
# Unless disabled, the server calls api.github.com (anonymous, at most daily) at startup.
# TELEGRAM_MCP_DISABLE_UPDATE_CHECK=1
# Agent surface (all optional; unset = previous behaviour, every tool and chat).
# TELEGRAM_TOOLSETS=default            # all | default | core,messages_read,messages_write,events,advanced_write,media,...
# TELEGRAM_TOOLS=telegram_write        # extra tools on top of the toolsets
# TELEGRAM_DISABLED_TOOLS=             # tools to hide
# TELEGRAM_READ_ONLY=1                 # hide every write tool
# TELEGRAM_ALLOWED_CHATS=-1001234567890,@team_chat   # set = every other chat denied
# TELEGRAM_DENIED_CHATS=
